# Run scripts/New-LocalEnv.ps1 to generate random local-only values.
DB_PASSWORD=
SESSION_TOKEN_PEPPER=
DEMO_INITIAL_PASSWORD=
DEMO_SEED_ENABLED=true
TEST_DB_PASSWORD=
DOCLING_INTERNAL_TOKEN=
# Optional exact-digest mirror for restricted networks; leave empty for the official registry.
DOCLING_PYTHON_IMAGE=
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=100
WEB_PORT=5173
API_PORT=8080
# mock is deterministic local demonstration; openai sends authorized content to your configured provider.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
AI_WORKER_ENABLED=true
